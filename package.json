{
  "name": "ieces-admin-portal",
  "version": "1.0.12",
  "description": "IECES Admin Portal",
  "author": "BuzzJay",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaybhee84/ieces-admin-portal.git"
  },
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "electron:dev": "vite",
    "dev:electron": "npm run electron:dev",
    "build": "vite build",
    "test:bsp": "node scripts/test-bsp.cjs",
    "test:ui": "node scripts/test-portal-ui.cjs",
    "preview": "vite preview",
    "electron": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder",
    "release": "npm run build && electron-builder --publish always",
    "test:security": "node scripts/test-security.cjs && node scripts/test-registration-security.cjs"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.10.2",
    "electron-builder": "^26.18.1",
    "vite": "^8.3.7",
    "vite-plugin-electron": "^1.1.2"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.70.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "build": {
    "appId": "com.ieces.adminportal",
    "productName": "IECES Admin Portal",
    "publish": [
      {
        "provider": "github",
        "owner": "buzzjay84",
        "repo": "ieces-admin-portal",
        "releaseType": "release"
      }
    ],
    "icon": "public/prieces",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "public/prieces.ico",
      "public/prieces.icns"
    ],
    "extraResources": [],
    "win": {
      "icon": "public/prieces.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "public/prieces.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "license": "MIT"
}
